--- a/sim/run_ps1_doplnek.txt
+++ b/sim/run_ps1_doplnek.txt
@@ -11,3 +11,7 @@
 #            na kterych stoji kroky "kruh v 16 SDPB" a "soucty v ALU54D"; s modely gowin_models_ext.v i s oficialnim
 #            prim_sim.v z Gowin IDE (misto extra: <Gowin>/IDE/simlib/gw1n/prim_sim.v) musi projit. ~1 s
     @{ name = "primchk"; top = "tb_prim_chk"; rtl = @(); tb = "tb_prim_chk.sv"; extra = @("gowin_models_ext.v") }
