// ============================================================
// File: pins.cst
// Tang Nano 9K (GW1NR-9C) na carrier desce v2.0
// Zdroj pravdy: FPGA_Module_2_0 netlist + BOARD_V20_CHECKLIST.md
// POZOR: bench s jumpery podle stareho zapojeni nutno prepojit!
// ============================================================

IO_LOC "clk_ref_10m"      63;  // 10MHz_GPSDO_CLK4 (LMK1C1104), IOR5A / RPLL_T_in
IO_LOC "clk_p0_100m"      35;  // PLL_CLK1 = U4 CLK_0, 0°   - IOB29A / GCLKT_4 (master!)
IO_LOC "clk_p2p5_100m"    34;  // PLL_CLK2 = U4 CLK_2, 90°  - IOB23B
IO_LOC "clk_p5_100m"      40;  // PLL_CLK3 = U4 CLK_4, 180° - IOB33B
IO_LOC "clk_p7p5_100m"    33;  // PLL_CLK4 = U4 CLK_6, 270° - IOB23A

IO_LOC "sig_in4"          28;  // DIV_Bit1/2 (MC100EP016 tap /4 pres MC100EPT23)
IO_LOC "sig_in16"         27;  // DIV_Bit3/4 (/16)

IO_LOC "div_res"          53;  // MC100EP016 MR (aktivni HIGH) - drzet LOW!

IO_LOC "led_tx"           16;  // on-module LED

// SPI slave (STM32H757 = master), 3.3V, Mode 0, CS active LOW
IO_LOC "spi_mosi"         54;
IO_LOC "spi_miso"         57;
IO_LOC "spi_sck"          55;
IO_LOC "spi_cs_n"         56;

IO_PORT "clk_ref_10m"      IO_TYPE=LVCMOS33;
IO_PORT "clk_p0_100m"      IO_TYPE=LVCMOS33;
IO_PORT "clk_p2p5_100m"    IO_TYPE=LVCMOS33;
IO_PORT "clk_p5_100m"      IO_TYPE=LVCMOS33;
IO_PORT "clk_p7p5_100m"    IO_TYPE=LVCMOS33;

IO_PORT "sig_in4"          IO_TYPE=LVCMOS33;
IO_PORT "sig_in16"         IO_TYPE=LVCMOS33;

IO_PORT "div_res"          IO_TYPE=LVCMOS33 DRIVE=8;

IO_PORT "led_tx"  IO_TYPE=LVCMOS18;

IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "spi_sck"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;  // Mode 0: hodiny idle LOW (ne UP!)
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
